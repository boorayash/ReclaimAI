# Postgres connection string (Neon / Supabase / Render Postgres)
DATABASE_URL="postgresql://user:password@host:5432/revenue_recovery?schema=public"

# Groq API key — https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="change-this-to-a-long-random-string"

# Port for the NestJS server
PORT=3000
